{
	"schemaVersion": 1,
	"id": "afktape",
	"version": "${version}",
	"name": "AFKTape",
	"description": "A simple mod that allows you to hold down keys while AFK.",
	"authors": [
		"SamIsPoggers"
	],
	"contact": {
		"homepage": "https://samispoggers.pages.dev/",
		"sources": "https://github.com/SamIsPoggers/AFKTape"
	},
	"license": "CC0-1.0",
	"icon": "assets/afktape/icon.png",
	"environment": "client",
	"entrypoints": {
		"main": [
			"io.github.samispoggers.fabric.AFKTapeFabric"
		],
		"client": [
			"io.github.samispoggers.fabric.AFKTapeFabricClient"
		],
		"modmenu": [
			"io.github.samispoggers.compat.ModMenuIntegration"
		]
	},
	"mixins": [
		"afktape.mixins.json"
	],
	"depends": {
		"fabricloader": ">=0.19.3",
		"minecraft": "${minecraft_version_range_fabric}",
		"java": ">=25",
		"fabric-api": "*",
		"yet_another_config_lib_v3": ">=${yacl_fabric_version}"
	}
}
